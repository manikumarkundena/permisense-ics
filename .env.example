# PermiSense local / production environment template.
# Never commit real secrets.

ENVIRONMENT=development
DEBUG=false

# Local:
DATABASE_URL=postgresql+asyncpg://permisense:permisense@localhost:5433/permisense

# Production: replace with your managed PostgreSQL DATABASE_URL.
# DATABASE_URL=postgresql+asyncpg://...

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

MODBUS_HOST=127.0.0.1
MODBUS_PORT=5020

# Backend-side Gemini key. Never expose this as NEXT_PUBLIC_*.
GEMINI_API_KEY=
